{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "canica-api",
  "main": "./src/worker.ts",
  "compatibility_date": "2026-06-05",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "vars": {
    "API_BASE_URL": "https://canica-api.nativerse.workers.dev",
    "TRUSTED_ORIGINS": "https://canica.nativerse.workers.dev,http://localhost:3000,http://localhost:3001",
    "SUPABASE_URL": "https://supabase.nativerse.dev",
    "STORAGE_BUCKET": "attachments"
  },
  "secrets": {
    "required": ["DATABASE_URL", "SUPABASE_SERVICE_ROLE_KEY"]
  }
}
