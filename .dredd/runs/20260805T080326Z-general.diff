+#!/usr/bin/env bash
+# dredd — wrapper CLI for the Dredd multi-agent reviewer.
+#
+# Subcommands:
+#   dredd review [spec-ref]       run dredd-judge (general code review)
+#   dredd security [spec-ref]     run dredd-sentinel (security audit)
+#   dredd full [spec-ref]         run both in parallel (2 Herd panes)
+#   dredd metrics [args]          show summary of past reviews (see .dredd/metrics.sh)
+#   dredd state                   show .dredd/state.md
+#   dredd help                    this help
+
+set -euo pipefail
+
+REPO_ROOT="$(git rev-parse --show-toplevel 2>/dev/null || pwd)"
+
+# Walk up from $REPO_ROOT until we find a `.dredd/` directory that actually has the
+# orchestration (must contain review.sh). The Dredd orchestration lives at the workspace root,
+# so sub-repos (hit-ever2/, hit-panel/, hit-cargo-web-v-1.2/) inherit it without needing their
+# own copy. The `review.sh` check guards against empty stub `.dredd/` dirs (e.g. left behind
+# by a `mkdir -p .dredd/logs` from a sub-repo) that would shadow the real orchestration.
+find_dredd_dir() {
+  local dir="$1"
+  while [[ "$dir" != "/" ]]; do
+    if [[ -f "$dir/.dredd/review.sh" ]]; then
+      echo "$dir/.dredd"
+      return 0
+    fi
+    dir="$(dirname "$dir")"
+  done
+  return 1
+}
+
+DREDD_DIR="$(find_dredd_dir "$REPO_ROOT")"
+if [[ -z "$DREDD_DIR" ]]; then
+  echo "Could not find .dredd/ in $REPO_ROOT or any parent directory." >&2
+  echo "Run from inside the hit workspace, or set DREDD_DIR explicitly." >&2
+  exit 1
+fi
+
+cmd="${1:-help}"
+shift || true
+
+case "$cmd" in
+  review)
+    DREDD_DIR="$DREDD_DIR" exec bash "$DREDD_DIR/review.sh" general "$@"
+    ;;
+  security)
+    DREDD_DIR="$DREDD_DIR" exec bash "$DREDD_DIR/review.sh" security "$@"
+    ;;
+  full)
+    # Both reviews in parallel. Each one splits its own pane.
+    DREDD_DIR="$DREDD_DIR" bash "$DREDD_DIR/review.sh" general  "$@" > "/tmp/dredd-general-$$.log"  2>&1 &
+    PID1=$!
+    DREDD_DIR="$DREDD_DIR" bash "$DREDD_DIR/review.sh" security "$@" > "/tmp/dredd-security-$$.log" 2>&1 &
+    PID2=$!
+    wait "$PID1"; RC1=$?
+    wait "$PID2"; RC2=$?
+    echo "===== dredd-judge (general) ====="
+    cat "/tmp/dredd-general-$$.log"
+    echo
+    echo "===== dredd-sentinel (security) ====="
+    cat "/tmp/dredd-security-$$.log"
+    rm -f "/tmp/dredd-general-$$.log" "/tmp/dredd-security-$$.log"
+    if [[ $RC1 -ne 0 || $RC2 -ne 0 ]]; then
+      echo "One or more reviews failed (general=$RC1, security=$RC2)." >&2
+      exit 1
+    fi
+    ;;
+  metrics)
+    exec bash "$DREDD_DIR/metrics.sh" "$@"
+    ;;
+  state)
+    if [[ -f "$DREDD_DIR/state.md" ]]; then
+      cat "$DREDD_DIR/state.md"
+    else
+      echo "No .dredd/state.md yet." >&2
+      exit 1
+    fi
+    ;;
+  help|--help|-h)
+    sed -n '2,12p' "$0" | sed 's/^# //;s/^#//'
+    ;;
+  *)
+    echo "Unknown command: $cmd" >&2
+    echo "Try 'dredd help'." >&2
+    exit 2
+    ;;
+esac
