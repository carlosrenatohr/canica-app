+#!/usr/bin/env bash
+# Dredd — Herd-orchestrated code reviewer.
+# Spawns a Codex reviewer in a split pane, sends the diff + spec,
+# waits for `done`, prints findings + self-evaluation.
+#
+# Usage:
+#   .dredd/review.sh general [spec-ref]     # adversarial code review
+#   .dredd/review.sh security [spec-ref]    # security audit
+#
+# spec-ref: optional path, URL, or anchor (e.g. "backlog-p4.md#spec-p4-05")
+#
+# Requires:
+#   - herdr 0.7+ (https://herdr.dev)
+#   - codex CLI on PATH (Codex is the default reviewer model)
+#   - run from a Herd pane (so the orchestrator is in a Herdr context)
+#
+# Self-evaluation: at the end, the reviewer's self-eval is appended to
+# .dredd/logs/YYYY-MM-DD-HHMM-<type>.md and to .dredd/runs/<id>/log.md.
+# The orchestrator reads that and proposes prompt improvements to
+# .dredd/improvements.md (human-curated).
+
+set -euo pipefail
+
+REVIEW_TYPE="${1:-}"
+SPEC_REF="${2:-}"
+REPO_ROOT="${REPO_ROOT:-$(git rev-parse --show-toplevel 2>/dev/null || pwd)}"
+
+# Pick skill + agent name by review type
+case "$REVIEW_TYPE" in
+  general)
+    SKILL_FILE="$HOME/.config/opencode/skills/reviewer/SKILL.md"
+    AGENT_NAME="dredd-judge"
+    MODEL="${DREDD_MODEL:-gpt-5.4}"
+    ;;
+  security)
+    SKILL_FILE="$HOME/.config/opencode/skills/security-reviewer/SKILL.md"
+    AGENT_NAME="dredd-sentinel"
+    MODEL="${DREDD_MODEL:-gpt-5.4}"
+    ;;
+  *)
+    echo "Usage: $0 [general|security] [spec-ref]" >&2
+    exit 2
+    ;;
+esac
+
+if [[ ! -f "$SKILL_FILE" ]]; then
+  echo "Skill file not found: $SKILL_FILE" >&2
+  exit 1
+fi
+
+# Save the diff to a file the reviewer can read
+TS="$(date -u +%Y%m%dT%H%M%SZ)"
+DIFF_FILE="$REPO_ROOT/.dredd/runs/${TS}-${REVIEW_TYPE}.diff"
+mkdir -p "$(dirname "$DIFF_FILE")"
+
+BRANCH="$(git -C "$REPO_ROOT" rev-parse --abbrev-ref HEAD 2>/dev/null || echo HEAD)"
+BASE="$(git -C "$REPO_ROOT" merge-base "$BRANCH" origin/main 2>/dev/null || git -C "$REPO_ROOT" rev-parse --abbrev-ref HEAD@{upstream} 2>/dev/null || echo HEAD)"
+if git -C "$REPO_ROOT" diff --quiet "$BASE"..."$BRANCH" 2>/dev/null; then
+  echo "No diff vs $BASE. Did you forget to commit?" >&2
+  exit 1
+fi
+git -C "$REPO_ROOT" diff "$BASE"..."$BRANCH" > "$DIFF_FILE"
+
+# Log file for self-evaluation capture
+LOG_FILE="$REPO_ROOT/.dredd/logs/${TS}-${REVIEW_TYPE}.md"
+mkdir -p "$(dirname "$LOG_FILE")"
+
+# 1. Split a pane to the right (no focus — orchestrator keeps working)
+SPLIT_JSON="$(herdr pane split --current --direction right --no-focus)"
+REVIEWER_PANE="$(printf '%s\n' "$SPLIT_JSON" | jq -r '.result.pane.pane_id')"
+
+# 2. Launch the reviewer in that pane
+herdr agent start "$AGENT_NAME" --kind codex --pane "$REVIEWER_PANE" -- -m "$MODEL"
+
+# 3. Build the prompt
+PROMPT="$(cat "$REPO_ROOT/.dredd/templates/review-prompt.md")"
+PROMPT="${PROMPT//\{\{REVIEW_TYPE\}\}/$REVIEW_TYPE}"
+PROMPT="${PROMPT//\{\{SKILL_FILE\}\}/$SKILL_FILE}"
+PROMPT="${PROMPT//\{\{DIFF_FILE\}\}/$DIFF_FILE}"
+PROMPT="${PROMPT//\{\{SPEC_REF\}\}/$SPEC_REF}"
+PROMPT="${PROMPT//\{\{REPO_ROOT\}\}/$REPO_ROOT}"
+
+# 4. Send and wait for done
+herdr agent prompt "$AGENT_NAME" "$PROMPT" --wait --until done --timeout 180000
+
+# 5. Read the result
+RESULT="$(herdr agent read "$AGENT_NAME" --source recent-unwrapped --lines 400)"
+
+# 6. Persist to log
+{
+  echo "# $REVIEW_TYPE review — $TS"
+  echo
+  echo "- repo: $REPO_ROOT"
+  echo "- branch: $BRANCH"
+  echo "- base: $BASE"
+  echo "- spec: $SPEC_REF"
+  echo "- diff: $DIFF_FILE"
+  echo
+  echo "## Findings + self-evaluation"
+  echo
+  printf '%s\n' "$RESULT"
+} > "$LOG_FILE"
+
+# 7. Print to stdout for the orchestrator
+printf '%s\n' "$RESULT"
+
+# 8. Auto-append to improvements.md (opt-in). Looks for "Suggested prompt improvement:" in the
+# self-eval section; if the suggestion is non-empty and > 30 chars, appends a row to
+# .dredd/improvements.md. Default OFF — set DREDD_AUTO_IMPROVE=1 to enable.
+if [[ "${DREDD_AUTO_IMPROVE:-0}" == "1" ]]; then
+  SUGGESTION="$(printf '%s\n' "$RESULT" \
+    | awk '/^### Self-evaluation/{flag=1; next} /^### /{flag=0} flag' \
+    | sed -n 's/^[[:space:]]*-\s*Suggested prompt improvement:[[:space:]]*//p' \
+    | head -1)"
+  if [[ -n "$SUGGESTION" && "${#SUGGESTION}" -gt 30 && "$SUGGESTION" != "none" && "$SUGGESTION" != "None." ]]; then
+    IMPROVE_FILE="$REPO_ROOT/.dredd/improvements.md"
+    DATE="$(date -u +%Y-%m-%d)"
+    SKILL_NAME="reviewer"
+    [[ "$REVIEW_TYPE" == "security" ]] && SKILL_NAME="security-reviewer"
+    printf '%s — %s — %s — %s — applied? no\n' \
+      "$DATE" "$SKILL_NAME" "$REVIEW_TYPE" "$SUGGESTION" >> "$IMPROVE_FILE"
+  fi
+fi
