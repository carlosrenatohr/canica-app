# Copy to .env and fill in real values. .env is gitignored; never commit secrets.
# Supabase Cloud project (see docs/how-to/database.md)

# Database password (Dashboard → Project Settings → Database → Connection string).
SUPABASE_DB_PASSWORD=REPLACE_DB_PASSWORD

# Postgres connection string (transaction pooler).
#   Dashboard → Project Settings → Database → Connection string → Transaction pooler
DATABASE_URL=postgresql://postgres.REPLACE_PROJECT_REF:REPLACE_DB_PASSWORD@aws-0-REPLACE_REGION.pooler.supabase.com:6543/postgres

# Base URL of the Supabase project (Dashboard → Project Settings → API).
SUPABASE_URL=https://REPLACE_PROJECT_REF.supabase.co

# Public anon key (safe to expose; used by the web client later).
SUPABASE_ANON_KEY=REPLACE_ANON_KEY

# Org id used by the API when no x-org-id header is sent (dev placeholder only).
ORG_ID=REPLACE_WITH_A_REAL_ORG_UUID
